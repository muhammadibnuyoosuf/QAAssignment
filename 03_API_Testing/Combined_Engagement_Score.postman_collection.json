              "query": [
                { "key": "companyId", "value": "{{company_id}}" },
                { "key": "vesselIds", "value": "all" },
                { "key": "startDate", "value": "2026-09-01T00:00:01.000Z" },
                { "key": "endDate", "value": "2026-09-30T23:59:59.999Z" },
                { "key": "dateFilter", "value": "CUSTOM" },
                { "key": "compact", "value": "true" }
              ]
            },
            "description": "Deliberately has NO Cookie header - this is the one request in the collection that must NOT carry the session cookie, since it's testing the unauthenticated case. Requires Postman's 'Disable cookies' setting to be on (see collection description) so its own cookie jar can't auto-attach a session cookie behind the scenes."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.cookies.jar().clear(pm.variables.get('base_url'), function (error) {",
                  "  if (error) console.log('A-01 pre-request cookie clear error:', error);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
