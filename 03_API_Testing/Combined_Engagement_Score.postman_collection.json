{
  "info": {
    "name": "Shiparc.AI - Combined Engagement Score API",
    "description": "Functional, negative, and auth tests for GET /api/admin/dashboard/engagement/combined-engagement-score (Company Admin Home dashboard).\n\nAUTH SETUP:\n1. Log into https://project.shiparc.ai/ as Company Admin in a real browser.\n2. Open DevTools > Network, find any authenticated request (e.g. combined-engagement-score), open its Headers tab, and copy the value of the session cookie from the Request Headers 'cookie' line - the one starting with '__Secure-next-auth.session-token'.\n3. Paste that value into this collection's 'admin_session_cookie' variable (Variables tab, 'CURRENT VALUE' column).\n4. Repeat with a Crew-role login to fill in 'crew_session_cookie' (needed only for A-02).\n5. In Postman Settings > General, turn on 'Disable cookies' - otherwise Postman's own cookie jar can auto-attach a stray session cookie to A-01, which is deliberately testing the no-cookie case.\n6. Run '0. SETUP' first to confirm the pasted cookie authenticates, then run folders 1-3.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://project.shiparc.ai" },
    { "key": "company_id", "value": "cmgrlybyk00uqrzs7j3eq3hrf" },
    { "key": "session_cookie_name", "value": "__Secure-next-auth.session-token" },
    { "key": "admin_session_cookie", "value": "PASTE_ADMIN_SESSION_COOKIE_VALUE_HERE", "type": "string" },
    { "key": "crew_session_cookie", "value": "PASTE_CREW_SESSION_COOKIE_VALUE_HERE", "type": "string" }
  ],
  "item": [
    {
      "name": "0. SETUP (read me first)",
      "item": [
        {
          "name": "Verify pasted admin session cookie works",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Cookie", "value": "{{session_cookie_name}}={{admin_session_cookie}}" }
            ],
            "url": "{{base_url}}/api/auth/session",
            "description": "Confirms the session cookie you manually pasted into 'admin_session_cookie' is valid, by calling NextAuth's own /api/auth/session endpoint and checking it returns the admin user. If this fails, re-copy the cookie value from a fresh browser login (session cookies expire/rotate)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('session has a user (cookie is valid)', () => {",
                  "  pm.expect(json).to.have.property('user');",
                  "  pm.expect(json.user).to.have.property('id');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Positive",
      "item": [
        {
          "name": "P-01 Fleet-wide, compact=true",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Cookie", "value": "{{session_cookie_name}}={{admin_session_cookie}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/dashboard/engagement/combined-engagement-score?companyId={{company_id}}&vesselIds=all&startDate=2026-09-01T00:00:01.000Z&endDate=2026-09-30T23:59:59.999Z&dateFilter=CUSTOM&compact=true",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "dashboard", "engagement", "combined-engagement-score"],
              "query": [
                { "key": "companyId", "value": "{{company_id}}" },
                { "key": "vesselIds", "value": "all" },
                { "key": "startDate", "value": "2026-09-01T00:00:01.000Z" },
                { "key": "endDate", "value": "2026-09-30T23:59:59.999Z" },
                { "key": "dateFilter", "value": "CUSTOM" },
                { "key": "compact", "value": "true" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('has overallIndex', () => pm.expect(json).to.have.property('overallIndex'));",
                  "pm.test('has vesselWiseEngagement array', () => pm.expect(json.vesselWiseEngagement).to.be.an('array'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Negative & Validation",
      "item": [
        {
          "name": "N-01 Missing companyId -> expect 400",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Cookie", "value": "{{session_cookie_name}}={{admin_session_cookie}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/dashboard/engagement/combined-engagement-score?vesselIds=all&startDate=2026-09-01T00:00:01.000Z&endDate=2026-09-30T23:59:59.999Z&dateFilter=CUSTOM&compact=true",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "dashboard", "engagement", "combined-engagement-score"],
              "query": [
                { "key": "vesselIds", "value": "all" },
                { "key": "startDate", "value": "2026-09-01T00:00:01.000Z" },
                { "key": "endDate", "value": "2026-09-30T23:59:59.999Z" },
                { "key": "dateFilter", "value": "CUSTOM" },
                { "key": "compact", "value": "true" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('message mentions companyId', () => pm.expect(pm.response.text()).to.include('companyId'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Auth & Authorization",
      "item": [
        {
          "name": "A-01 No session cookie -> expect 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/dashboard/engagement/combined-engagement-score?companyId={{company_id}}&vesselIds=all&startDate=2026-09-01T00:00:01.000Z&endDate=2026-09-30T23:59:59.999Z&dateFilter=CUSTOM&compact=true",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "dashboard", "engagement", "combined-engagement-score"],
              "query": [
                { "key": "companyId", "value": "{{company_id}}" },
                { "key": "vesselIds", "value": "all" },
                { "key": "startDate", "value": "2026-09-01T00:00:01.000Z" },
                { "key": "endDate", "value": "2026-09-30T23:59:59.999Z" },
                { "key": "dateFilter", "value": "CUSTOM" },
                { "key": "compact", "value": "true" }
              ]
            },
            "description": "Deliberately has NO Cookie header - this is the one request in the collection that must NOT carry the session cookie, since it's testing the unauthenticated case. Requires Postman's 'Disable cookies' setting to be on (see collection description)."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.cookies.jar().clear(pm.variables.get('base_url'), function (error) {",
                  "  if (error) console.log('A-01 pre-request cookie clear error:', error);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "A-02 Crew role session -> expect 403",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Cookie", "value": "{{session_cookie_name}}={{crew_session_cookie}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/dashboard/engagement/combined-engagement-score?companyId={{company_id}}&vesselIds=all&startDate=2026-09-01T00:00:01.000Z&endDate=2026-09-30T23:59:59.999Z&dateFilter=CUSTOM&compact=true",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "dashboard", "engagement", "combined-engagement-score"],
              "query": [
                { "key": "companyId", "value": "{{company_id}}" },
                { "key": "vesselIds", "value": "all" },
                { "key": "startDate", "value": "2026-09-01T00:00:01.000Z" },
                { "key": "endDate", "value": "2026-09-30T23:59:59.999Z" },
                { "key": "dateFilter", "value": "CUSTOM" },
                { "key": "compact", "value": "true" }
              ]
            },
            "description": "Uses 'crew_session_cookie' instead of 'admin_session_cookie' - paste a session cookie obtained from a real browser login as the crew test user."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
