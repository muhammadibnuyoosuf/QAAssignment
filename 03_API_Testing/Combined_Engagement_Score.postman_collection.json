              { "key": "Cookie", "value": "{{session_cookie_name}}={{admin_session_cookie}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/dashboard/engagement/combined-engagement-score?companyId={{company_id}}&vesselIds=all&startDate=2026-09-01T00%3A00%3A01.000Z%27&endDate=2026-09-30T23:59:59.999Z&dateFilter=CUSTOM&compact=true",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "dashboard", "engagement", "combined-engagement-score"],
              "query": [
                { "key": "companyId", "value": "{{company_id}}" },
                { "key": "vesselIds", "value": "all" },
                { "key": "startDate", "value": "2026-09-01T00:00:01.000Z'" },
                { "key": "endDate", "value": "2026-09-30T23:59:59.999Z" },
                { "key": "dateFilter", "value": "CUSTOM" },
                { "key": "compact", "value": "true" }
              ]
            },
            "description": "A single trailing quote on startDate breaks the raw SQL query server-side and the error response echoes the query text back - error-based confirmation of SQL injection via prisma.$queryRawUnsafe(). Do not extend this probe to UNION/boolean-blind extraction without explicit engagement sign-off."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('CRITICAL DEFECT: single quote breaks raw SQL query (500, query text leaked)', () => {",
                  "  pm.expect(pm.response.code).to.eql(500);",
                  "  pm.expect(pm.response.text()).to.include('queryRawUnsafe');",
                  "});"
                ]
